# Application Environment
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Verification & Model Configuration
# Core audit operates locally with ₹0 budget. No API keys required.
MODEL_ID=microsoft/deberta-base-mnli
DEVICE=cpu
MODEL_ENABLED=true

# Processing & Safety Caps
MAX_ANSWER_CHARS=40000
MAX_SOURCE_CHARS=150000
MAX_FILES=5
MAX_FILE_BYTES=10485760
MAX_CLAIMS=50
